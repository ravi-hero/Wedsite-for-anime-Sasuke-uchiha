rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function isAdmin() { return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
  match /admins/{uid} { allow read: if request.auth != null && request.auth.uid == uid; allow write: if false; }
  match /videos/{id} {
   allow read: if true;
   allow create: if isAdmin() && request.resource.data.createdBy == request.auth.uid;
   allow update, delete: if isAdmin();
  }
 }
}