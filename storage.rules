rules_version = '2';
service firebase.storage {
 match /b/{bucket}/o {
  function isAdmin() { return request.auth != null && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid)); }
  match /videos/{uid}/{fileName} {
   allow read: if true;
   allow create, update: if isAdmin() && request.auth.uid == uid && request.resource.size < 500 * 1024 * 1024 && request.resource.contentType.matches('video/(mp4|webm|ogg)');
   allow delete: if isAdmin();
  }
 }
}